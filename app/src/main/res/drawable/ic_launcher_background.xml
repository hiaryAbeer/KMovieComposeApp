<?xml version="1.0" encoding="utf-8"?>
<!-- Diagonal purple gradient behind the adaptive launcher icon. The gradient runs across the
     72dp visible area (18..90) so the masked icon matches the original artwork's colors. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90"
                android:startColor="#FF5A2EE0"
                android:endColor="#FF35168F" />
        </aapt:attr>
    </path>
</vector>
